{
  "name": "cmsassstarter",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "optimize-images": "image-transmutation --run --sourceFolder './build/images' --targetFolder './build/images.optimized' --inputFormats 'jpg' --inputFormats 'jpeg' --inputFormats 'png' --outputFormats 'png' --outputFormats 'webp' --outputFormats 'avif' && mv ./build/images ./build/images.bak && mv ./build/images.optimized ./build/images && rm -rf ./build/images.bak",
    "postbuild": "npm run optimize-images && svelte-sitemap --domain https://htmltoolkit.github.io/",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "test": "vitest",
    "test_run": "vitest run",
    "lint": "eslint .",
    "format": "prettier --write --plugin prettier-plugin-svelte ./",
    "format_check": "prettier --check --plugin prettier-plugin-svelte ./",
    "postinstall": "patch-package"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.0",
    "@sveltejs/kit": "^2.21.1",
    "@sveltejs/vite-plugin-svelte": "^5.0.3",
    "@tailwindcss/postcss": "^4.0.9",
    "@tailwindcss/typography": "^0.5.13",
    "@types/glob": "^8.1.0",
    "@types/html-to-text": "^9.0.4",
    "@types/jsdom": "^21.1.7",
    "@typescript-eslint/eslint-plugin": "^8.57.1",
    "@typescript-eslint/parser": "^8.57.1",
    "daisyui": "^5.0.0",
    "eslint": "^8.28.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-svelte": "^2.45.1",
    "fuse.js": "^7.0.0",
    "glob": "^10.4.5",
    "html-to-text": "^9.0.5",
    "jsdom": "^24.1.1",
    "patch-package": "^8.0.1",
    "postcss": "^8.4.31",
    "prettier": "^3.1.0",
    "prettier-plugin-svelte": "^3.2.6",
    "mdsvex": "^0.11.2",
    "rehype-external-links": "^3.0.0",
    "rehype-slug": "^5.0.0",
    "rehype-autolink-headings": "^6.1.1",
    "remark-emoji": "^5.0.1",
    "remark-gfm": "^4.0.1",
    "super-sitemap": "^1.0.7",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "tailwindcss": "^4.0.9",
    "typescript": "^5.5.0",
    "vite": "^6.3.5",
    "vitest": "^3.0.7",
    "image-transmutation": "^1.0.1",
    "svelte-sitemap": "^3.0.0"
  },
  "type": "module",
  "dependencies": {
    "handlebars": "^4.7.8",
    "resend": "^3.5.0"
  }
}